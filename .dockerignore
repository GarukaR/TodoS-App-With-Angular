# .dockerignore - Excludes files from Docker build context
# Similar to .gitignore but for Docker builds
# Reduces build context size and speeds up builds
# Prevents sensitive files from being copied into images

# ============================================
# INSTRUCTIONS:
# ============================================
# 1. Files/folders listed here are NOT sent to Docker daemon during build
# 2. Use * for wildcards, ** for recursive matching
# 3. Use ! to negate/include previously excluded patterns
# 4. Comment lines with #
# 5. Reducing build context improves build speed and security

# ============================================
# Version Control
# ============================================
.git
.gitignore
.gitattributes
.github

# ============================================
# Dependencies (will be installed during build)
# ============================================
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# ============================================
# Angular Build Outputs
# ============================================
dist
tmp
out-tsc
bazel-out

# ============================================
# Development & Testing
# ============================================
.angular
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test coverage
coverage
.nyc_output

# Testing
*.spec.ts
*.spec.js
e2e
karma.conf.js
protractor.conf.js

# ============================================
# Documentation
# ============================================
*.md
!README.md
docs
.editorconfig

# ============================================
# CI/CD
# ============================================
.circleci
.travis.yml
.gitlab-ci.yml
azure-pipelines.yml
Jenkinsfile

# ============================================
# Docker Files (don't copy Docker files into image)
# ============================================
Dockerfile*
docker-compose*.yml
.dockerignore

# ============================================
# Environment & Secrets (IMPORTANT!)
# ============================================
.env
.env.*
*.pem
*.key
secrets

# ============================================
# Logs
# ============================================
logs
*.log
lerna-debug.log*

# ============================================
# OS Files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ============================================
# Optional: Uncomment if needed
# ============================================
# .eslintrc.js
# .prettierrc
# tsconfig.json
# angular.json
